# Copy to .env for local development. Never commit .env or real credentials.
# These values are local-development placeholders only.
POSTGRES_USER=quizforge
POSTGRES_PASSWORD=quizforge_dev_only
POSTGRES_DB=quizforge
POSTGRES_PORT=5432

DATABASE_URL=postgresql://quizforge:quizforge_dev_only@localhost:5432/quizforge?schema=public

API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# JWT & Authentication (Stage S03)
JWT_SECRET=quizforge_dev_jwt_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

